{
  "name": "ugnext",
  "version": "0.5.0",
  "private": true,
  "scripts": {
    "predev": "bun run scripts/prebuild.ts",
    "dev": "next dev",
    "build": "bun run scripts/prebuild.ts && graphql-codegen && next build",
    "build:webpack": "bun run scripts/prebuild.ts && graphql-codegen && next build --webpack",
    "start": "next start",
    "static-build": "NEXT_STATIC_OUTPUT=true bun run build:webpack",
    "static-start": "NEXT_STATIC_OUTPUT=true bunx serve@latest out",
    "analyze": "ANALYZE=true next dev",
    "export": "next build && next export",
    "format": "prettier -w ./",
    "test": "bun run build && bunx playwright test",
    "test:update-snapshots": "next build && bunx playwright test --update-snapshots",
    "docker:test:update-snapshots": "docker compose run --rm playwright-update-snapshots",
    "docker:clean": "docker compose down -v",
    "codegen:compile": "graphql-codegen",
    "codegen:watch": "graphql-codegen -w",
    "load-test": "k6 run tests/load/graphql-load.js",
    "load-test:test": "k6 run --env BASE_URL=$LOAD_TEST_BASE_URL tests/load/graphql-load.js"
  },
  "dependencies": {
    "@awesome.me/kit-7993323d0c": "^1.0.11",
    "@drupal/linkset": "^1.0.3",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@netlify/plugin-nextjs": "^5.16.6",
    "@next/third-parties": "^16.4.5",
    "@orama/orama": "^3.1.18",
    "@orama/plugin-qps": "^3.1.18",
    "@orama/stopwords": "^3.1.18",
    "@oramacloud/client": "^2.1.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/object-hash": "^3.0.6",
    "@uoguelph/react-components": "^1.11.0-rc.0",
    "@uoguelph/web-components": "2.2.0-rc.1",
    "conditional-wrap": "^1.0.3",
    "glob": "^14.0.3",
    "html-react-parser": "^6.1.9",
    "jsonwebtoken": "^9.0.3",
    "ldapts": "^9.2.0",
    "nanoid": "^6.0.2",
    "next": "^16.4.5",
    "next-auth": "^4.24.15",
    "next-drupal": "^2.0.1",
    "object-hash": "^3.0.0",
    "react": "^19.3.1",
    "react-animate-height": "^3.2.4",
    "react-dom": "^19.3.1",
    "react-transition-group": "^4.4.5",
    "sharp": "^0.35.5",
    "swr": "^2.5.1",
    "tailwind-variants": "^4.0.1",
    "unraw": "^3.0.0",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@apollo/client": "^4.3.6",
    "@apollo/client-integration-nextjs": "^0.14.5",
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/client-preset": "^6.2.3",
    "@graphql-codegen/fragment-matcher": "^7.1.0",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@headlessui/react": "^2.2.10",
    "@headlessui/tailwindcss": "^0.2.2",
    "@netlify/edge-functions": "^4.0.3",
    "@next/bundle-analyzer": "^16.4.5",
    "@parcel/watcher": "^2.6.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/k6": "^2.3.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@uoguelph/tailwind-theme": "^1.1.0-rc.0",
    "dotenv": "^18.0.9",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.5",
    "graphql": "^17.0.2",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-embed": "^0.8.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "stemmer": "^2.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "terser-webpack-plugin": "^5.6.1",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "@tailwindcss/oxide",
    "core-js",
    "core-js-pure",
    "esbuild",
    "sharp",
    "unrs-resolver"
  ]
}
